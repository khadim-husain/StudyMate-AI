DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/studymate_db
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004
JWT_SECRET_KEY=studymate_super_secret_jwt_key_2026_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20
ENVIRONMENT=development
CORS_ORIGINS=["*"]

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=

# SMTP Email Configuration (for Password Reset & Verification)
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your_email@gmail.com, SMTP_PASSWORD=your_app_password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@studymate.ai
SMTP_FROM_NAME="StudyMate AI"
SMTP_TLS=true
RESET_TOKEN_EXPIRE_MINUTES=15
FRONTEND_URL=http://localhost:8081
APP_DEEP_LINK_SCHEME=studymate
