# ========================================================
# StudyMate AI Mobile Environment Configuration Template
# ========================================================

# Networking: Set to true to use react-native fetch polyfill
EXPO_PUBLIC_USE_RN_FETCH=true

# Backend API URL (Update for your development or production environment)
# Local Development: http://<YOUR_LOCAL_LAN_IP>:8000/api/v1 (e.g. http://192.168.1.100:8000/api/v1)
# Android Emulator:   http://10.0.2.2:8000/api/v1
# Web Browser:        http://localhost:8000/api/v1
# Production/Tunnel:  https://your-production-domain.onrender.com/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# Google OAuth 2.0 Client IDs (Obtain from Google Cloud Console)
# Web Client ID (Required for Google Identity on Web and auth token exchange)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=your_web_client_id.apps.googleusercontent.com

# Android Client ID (Package name: com.studymate.ai, with your SHA-1 signing certificate fingerprint)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=your_android_client_id.apps.googleusercontent.com

# iOS Client ID (Optional, for standalone iOS builds)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=your_ios_client_id.apps.googleusercontent.com
