# ========================================================
# StudyMate AI - Safe Git Exclusion Rules
# ========================================================

# Python & Virtual Environments
**/venv/
**/.venv/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
.pytest_cache/
.coverage
htmlcov/

# Node.js & React Native / Expo
**/node_modules/
**/.expo/
**/dist/
**/web-build/
expo-env.d.ts
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*

# Environment Variables & Secrets
**/.env
**/.env.*
**/.env*.local
!**/.env.example

# Binaries & Executables
*.exe
*.dll
*.so
*.dylib

# Uploads & User Data
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# Database Backups & Dumps
**/backups/
*.dump
*.sql

# System & OS Files
.DS_Store
Thumbs.db
*.log
